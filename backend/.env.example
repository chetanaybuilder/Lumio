ENV=development
APP_NAME=VexoVault
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vexovault
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/vexovault
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=replace-with-a-32-character-secret-key-for-jwt-tokens
COOKIE_SECURE=false
GEMINI_API_KEY=your-gemini-api-key
