# Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Storage and Session Lifetimes
LUMIO_TEMP_DIR=./temp
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
FRONTEND_ORIGINS=http://localhost:5173,https://lumio-study.pages.dev

# Configure secrets in the process environment, never in source control.
